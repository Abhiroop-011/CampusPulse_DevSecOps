# ==============================================================================
# CampusPulse Terraform Variables Example
# Copy to terraform.tfvars and customize before running terraform apply
# ==============================================================================
aws_region          = "ap-south-1"
environment         = "prod"
cluster_name        = "campuspulse-eks"
cluster_version     = "1.31"
vpc_cidr            = "10.30.0.0/16"
node_instance_types = ["t3.medium"]
min_nodes           = 2
max_nodes           = 4
desired_nodes       = 2
